{
    "editor.wordWrap": "on",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.wordWrapColumn": 120,
    "editor.wrappingIndent": "same",
    "editor.lineNumbers": "on",
    "editor.folding": false,
    "editor.lineHeight": 28,
    "editor.padding.top": 3,
    "editor.padding.bottom": 3,
    "editor.renderWhitespace": "selection",
    "breadcrumbs.enabled": false,
    "editor.fontSize": 15.5,
    "workbench.colorTheme": "One Dark Pro Night Flat",
    "chat.disableAIFeatures": false,
    "chat.agent.enabled": false,
    "chat.agent.sandbox.enabled": "off",
    "explorer.sortOrder": "modified",
    "window.menuBarVisibility": "compact",
    "window.commandCenter": false,
    "workbench.activityBar.location": "top",
    "workbench.sideBar.location": "right",
    "workbench.iconTheme": "material-icon-theme",
    "editor.fontFamily": "Fira Code",
    "editor.fontLigatures": true,
    "editor.minimap.enabled": false,
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "workbench.colorCustomizations": {
        "terminal.foreground": "#a1e9ec",
        "terminal.background": "#171717",
        "terminalCursor.foreground": "#FFFFFF",
        "terminal.ansiGreen": "#00FF00",
        "terminal.ansiYellow": "#FFD700",
        "terminal.ansiBrightBlue": "#0033ff"
    },
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    },
    "python.defaultInterpreterPath": "C:\\Users\\jinsj\\OneDrive\\Desktop\\Project menu\\venv",
    "chat.viewSessions.orientation": "stacked",
    "workbench.editor.empty.hint": "hidden",
    "claudeCode.preferredLocation": "panel",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorBlinking": "smooth",
    "editor.smoothScrolling": true,
    "editor.cursorWidth": 4,
    "editor.cursorStyle": "line",
    "editor.mouseWheelSmoothScroll": true,
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.gpuAcceleration": "off",
    "window.systemColorTheme": "dark",
    "window.autoDetectColorScheme": false,
    "editor.mouseWheelZoom": true
}